#include <Arduino.h>
#include <BleGamepad.h>
#include <esp_sleep.h>
#include <driver/rtc_io.h>

// =====================================================
// BLUETOOTH GAMEPAD
// =====================================================

BleGamepad bleGamepad("STEERING BUTTON BOX", "ESP32", 100);
BleGamepadConfiguration config;

// =====================================================
// SETTINGS
// =====================================================

const unsigned long SLEEP_TIMEOUT_MS =
  25UL * 60UL * 1000UL;

const unsigned long DEBOUNCE_MS = 25;
const unsigned long LOOP_DELAY_MS = 10;
const int POT_ACTIVITY_THRESHOLD = 100;

unsigned long lastActivityTime = 0;

void markActivity() {
  lastActivityTime = millis();
}

// =====================================================
// PHYSICAL BUTTON PINS
// =====================================================

const uint8_t buttonPins[12] = {
  32, 25, 26, 33, 4, 5,
  18, 21, 22, 23, 19, 15
};

// true = HIGH means pressed
// false = LOW means pressed

const bool buttonActiveHigh[12] = {
  true, true, false, false,
  false, true, false, false,
  false, false, false, false
};

// GPIO 18 -> Gamepad Button 13

const uint8_t gamepadButtons[12] = {
  BUTTON_1,
  BUTTON_2,
  BUTTON_3,
  BUTTON_4,
  BUTTON_5,
  BUTTON_6,
  BUTTON_13,
  BUTTON_8,
  BUTTON_9,
  BUTTON_10,
  BUTTON_11,
  BUTTON_12
};

// =====================================================
// POTENTIOMETERS
// =====================================================

const uint8_t potPins[4] = {
  34, 13, 14, 27
};

int potRaw[4] = {0, 0, 0, 0};
int potActivityReference[4] = {0, 0, 0, 0};

// =====================================================
// BUTTON STATES
// =====================================================

bool stableButtonState[12] = {false};
bool lastRawButtonState[12] = {false};

unsigned long lastDebounceTime[12] = {0};

// =====================================================
// READ BUTTON
// =====================================================

bool readButtonPressed(uint8_t index) {
  int level = digitalRead(buttonPins[index]);

  if (buttonActiveHigh[index]) {
    return level == HIGH;
  }

  return level == LOW;
}

// =====================================================
// INITIALIZE BUTTONS
// =====================================================

void initializeButtons() {
  unsigned long now = millis();

  for (int i = 0; i < 12; i++) {
    if (buttonActiveHigh[i]) {
      pinMode(buttonPins[i], INPUT_PULLDOWN);
    } else {
      pinMode(buttonPins[i], INPUT_PULLUP);
    }

    bool state = readButtonPressed(i);

    stableButtonState[i] = state;
    lastRawButtonState[i] = state;
    lastDebounceTime[i] = now;
  }

  Serial.println("Buttons initialized.");
  Serial.println("GPIO 18 -> Gamepad Button 13");
}

// =====================================================
// INITIALIZE POTENTIOMETERS
// =====================================================

void initializePots() {
  analogReadResolution(12);

  for (int i = 0; i < 4; i++) {
    pinMode(potPins[i], INPUT);

    potRaw[i] = analogRead(potPins[i]);
    potActivityReference[i] = potRaw[i];
  }

  Serial.println("Four potentiometers initialized.");
}

// =====================================================
// UPDATE BUTTONS WITH DEBOUNCE
// =====================================================

void updateButtons() {
  unsigned long now = millis();

  for (int i = 0; i < 12; i++) {
    bool rawState = readButtonPressed(i);

    if (rawState != lastRawButtonState[i]) {
      lastRawButtonState[i] = rawState;
      lastDebounceTime[i] = now;
    }

    if ((unsigned long)(now - lastDebounceTime[i])
        >= DEBOUNCE_MS) {

      if (stableButtonState[i] != rawState) {
        stableButtonState[i] = rawState;
        markActivity();

        Serial.print("GPIO ");
        Serial.print(buttonPins[i]);
        Serial.print(" -> Gamepad Button ");
        Serial.print(i == 6 ? 13 : i + 1);
        Serial.print(" = ");

        Serial.println(
          rawState ? "PRESSED" : "RELEASED"
        );
      }
    }
  }
}

// =====================================================
// UPDATE POTENTIOMETERS
// =====================================================

void updatePots() {
  for (int i = 0; i < 4; i++) {
    int value = analogRead(potPins[i]);
    potRaw[i] = value;

    if (abs(value - potActivityReference[i])
        >= POT_ACTIVITY_THRESHOLD) {

      potActivityReference[i] = value;
      markActivity();
    }
  }
}

// =====================================================
// CONVERT POTENTIOMETER TO GAMEPAD AXIS
// =====================================================

int16_t convertPotToAxis(int value) {
  value = constrain(value, 0, 4095);

  long mappedValue = map(
    value, 0, 4095, -32767, 32767
  );

  return (int16_t)mappedValue;
}

// =====================================================
// SYNCHRONIZE BUTTONS
// =====================================================

void syncGamepadButtons() {
  for (int i = 0; i < 12; i++) {
    if (stableButtonState[i]) {
      bleGamepad.press(gamepadButtons[i]);
    } else {
      bleGamepad.release(gamepadButtons[i]);
    }
  }
}

// =====================================================
// UPDATE GAMEPAD AXES
// =====================================================

void updateGamepadAxes() {
  int16_t x  = convertPotToAxis(potRaw[0]);
  int16_t y  = convertPotToAxis(potRaw[1]);
  int16_t z  = convertPotToAxis(potRaw[2]);
  int16_t rx = convertPotToAxis(potRaw[3]);

  bleGamepad.setAxes(
    x, y, z, rx,
    0, 0, 0, 0
  );
}

// =====================================================
// CONFIGURE DEEP SLEEP WAKE-UP
// =====================================================

void configureWakeupPins() {
  rtc_gpio_init(GPIO_NUM_32);
  rtc_gpio_set_direction(
    GPIO_NUM_32, RTC_GPIO_MODE_INPUT_ONLY
  );
  rtc_gpio_pulldown_en(GPIO_NUM_32);
  rtc_gpio_pullup_dis(GPIO_NUM_32);

  rtc_gpio_init(GPIO_NUM_25);
  rtc_gpio_set_direction(
    GPIO_NUM_25, RTC_GPIO_MODE_INPUT_ONLY
  );
  rtc_gpio_pulldown_en(GPIO_NUM_25);
  rtc_gpio_pullup_dis(GPIO_NUM_25);

  uint64_t wakeMask =
    (1ULL << 32) | (1ULL << 25);

  esp_err_t result = esp_sleep_enable_ext1_wakeup(
    wakeMask,
    ESP_EXT1_WAKEUP_ANY_HIGH
  );

  if (result != ESP_OK) {
    Serial.print("Wake-up configuration error: ");
    Serial.println((int)result);
  }
}

// =====================================================
// ENTER DEEP SLEEP
// =====================================================

void enterDeepSleep() {
  Serial.println("25 minutes of inactivity.");
  Serial.println("Entering Deep Sleep...");

  if (bleGamepad.isConnected()) {
    for (int i = 0; i < 12; i++) {
      bleGamepad.release(gamepadButtons[i]);
    }

    bleGamepad.sendReport();
    delay(100);
  }

  bleGamepad.end();
  delay(100);

  configureWakeupPins();

  Serial.println(
    "Press GPIO 32 or GPIO 25 to wake ESP32."
  );

  Serial.flush();
  esp_deep_sleep_start();
}

// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);

  // Allow the board to stabilize after power-on
  delay(1500);

  Serial.println();
  Serial.println("================================");
  Serial.println("STEERING BUTTON BOX");
  Serial.println("ESP32 BLE GAMEPAD STARTING");
  Serial.println("================================");

  Serial.print("Wake reason: ");
  Serial.println((int)esp_sleep_get_wakeup_cause());

  initializeButtons();
  initializePots();

  config.setControllerType(CONTROLLER_TYPE_GAMEPAD);
  config.setButtonCount(16);
  config.setHatSwitchCount(1);
  config.setAutoReport(false);

  updateGamepadAxes();

  // Start Bluetooth after hardware initialization
  delay(1000);

  Serial.println("Starting Bluetooth BLE...");

  bleGamepad.begin(&config);

  // Allow BLE stack to initialize
  delay(1500);

  markActivity();

  Serial.println("Bluetooth initialization requested.");
  Serial.println("Device name: STEERING BUTTON BOX");
  Serial.println("Waiting for connection...");
}

// =====================================================
// MAIN LOOP
// =====================================================

void loop() {
  updateButtons();
  updatePots();

  if (bleGamepad.isConnected()) {
    syncGamepadButtons();
    updateGamepadAxes();
    bleGamepad.sendReport();
  }

  if ((unsigned long)(millis() - lastActivityTime)
      >= SLEEP_TIMEOUT_MS) {
    enterDeepSleep();
  }

  delay(LOOP_DELAY_MS);
}
